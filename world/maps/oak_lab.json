  "dialogue": {
    "oak_hello": ["OAK: Ah, there you are! Welcome to my lab.", "This is where I study everything about POKéMON.", "Have a look around. When you're ready, come see me by the POKé BALLS!"],
    "oak_pc": ["PROF. OAK's computer.", "The screen is full of charts about how POKéMON grow and evolve."],
    "starters": ["Three POKé BALLS rest in the holder.", "Each one holds a POKéMON PROF. OAK caught for new trainers.", "Better ask the PROFESSOR before choosing one!"],
    "board_n": ["LAB NOTES", "Feed the tank at noon. Check the hoist chain.", "New trainers arrive Monday!"],
    "board_door": ["WELCOME to the OAK POKéMON RESEARCH LAB.", "Please wipe your feet, and ask before touching anything!"],
    "desk_back": ["PROF. OAK's writing desk.", "A letter is half written: 'Dear Professor Elm, about the egg...'"],
    "study_door": ["The door to PROF. OAK's study.", "It's locked. A sign says: PRIVATE - THINKING IN PROGRESS."],
    "pc_w": ["The computer is running the POKéDEX program.", "It shows a long list of POKéMON with question marks."],
    "dex_table": ["Brand-new POKéDEXes, ready for new trainers.", "They're high-tech encyclopedias that record every POKéMON you meet."],
    "board_dex": ["POKéDEX PROJECT", "Status: 63% of known POKéMON catalogued.", "Field data is due on Friday."]
  },
