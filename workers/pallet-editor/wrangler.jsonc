// The world editor's backend (web/world/editor.html): drafts, saved versions
// and publish requests, all in the R2 bucket pallet-editor. Protected by the
// EDITOR_TOKEN secret (the editor's passphrase). See src/index.js.
{
  "name": "pallet-editor",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "pallet-editor" }]
}
