# Built ROMs are copies of Nintendo's game: never commit them.
*.gb
*.gbc
web/pokered.gbc
tools/rgbds-*/
node_modules/
# downloaded CC0 scans (tools/world/fetch-assets.mjs); not used by the anime style
web/world/assets/
web/world/preview.html
web/world/lineup.html

# workers' scratch copies
*_tmp.js
*_tmp.html

# model sources stay on this machine; only the finished player model is published
web/world/local/*
!web/world/local/ash.glb
__pycache__/

# the TV output plugin's builds (tools/native/tv_plugin; ios.yml copies the
# phone's into native/tv/ios/ with its .gdextension just before the export)
tools/native/tv_plugin/bin/
tools/native/tv_plugin/src/*.o
tools/native/tv_plugin/src/*.os
.sconsign.dblite
native/tv/ios/
native/tv/linux/
