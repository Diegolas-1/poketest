[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
rendering_device/driver.ios="metal"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
textures/vram_compression/import_etc2_astc=true

[importer_defaults]

texture={
"mipmaps/generate": true
}

[shader_globals]

ink_focus={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
veg_cam={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
battle_arena={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
battle_arena_v={
"type": "float",
"value": 0.0
}
dn_sun={
"type": "vec4",
"value": Vector4(1, 1, 1, 0)
}
dn_amb={
"type": "vec4",
"value": Vector4(1, 1, 1, 0)
}
