; Pallet Town, native (Godot 4). The iPhone build runs this project.
config_version=5

[application]

config/name="Pallet Town"
run/main_scene="res://screens.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"

[autoload]

; Boot must stay first: it loads the over-the-air patch packs before the
; other autoloads and the main scene are read (boot.gd)
Boot="*res://boot.gd"
Settings="*res://settings.gd"
Ink="*res://ink.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1
; ProMotion: lets the iPhone run at 120 Hz (CADisableMinimumFrameDurationOnPhone)
window/ios/allow_high_refresh_rate=true

; controls: keyboard + gamepad (Switch Pro / GameCube style pads); Settings
; swaps use / back on the face buttons for the "Face buttons" option
[input]

move_left={
